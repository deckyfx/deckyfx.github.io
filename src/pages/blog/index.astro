---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog — Decky FX" description="Writings on development, tools, and ideas.">
  <h1 class="text-3xl font-bold mb-2 tracking-tight">Blog</h1>
  <p class="text-zinc-400 mb-12">Writings on development, tools, and ideas.</p>

  {posts.length === 0 ? (
    <p class="text-zinc-500">No posts yet. Check back soon.</p>
  ) : (
    <div class="grid gap-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block p-5 rounded-xl border border-zinc-800 hover:border-zinc-600 bg-zinc-900/50 hover:bg-zinc-900 transition-all"
        >
          <div class="flex items-start justify-between gap-4">
            <h2 class="font-semibold text-zinc-200 group-hover:text-white transition-colors">
              {post.data.title}
            </h2>
            <time class="text-xs text-zinc-500 shrink-0 mt-1">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>
          <p class="text-sm text-zinc-500 mt-1">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="flex gap-2 mt-3">
              {post.data.tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400">{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  )}
</Layout>

---
const highlighted = [
  {
    name: "agenthub",
    description: "Command fleet of AI agents using a dashboard",
    longDescription: "A web-based dashboard to manage and orchestrate fleets of AI agents. Monitor agent activity, manage conversations, and coordinate multi-agent workflows from a single interface.",
    language: "TypeScript",
    stars: 0,
    url: "https://github.com/deckyfx/agenthub",
    image: "/images/agenthub.png",
  },
  {
    name: "anpan-os",
    description: "CasaOS Alternative powered by Bun",
    longDescription: "A self-hosted home server OS dashboard built as a lightweight alternative to CasaOS. Powered by Bun for blazing-fast performance with Docker container management and app store.",
    language: "TypeScript",
    stars: 0,
    url: "https://github.com/deckyfx/anpan-os",
    image: "/images/anpan.png",
  },
  {
    name: "manga-reader",
    description: "Manga Reader + OCR + Translation",
    longDescription: "A manga reading app with built-in OCR and machine translation. Read raw Japanese manga and get instant translations powered by OCR text extraction and translation APIs.",
    language: "TypeScript",
    stars: 1,
    url: "https://github.com/deckyfx/manga-reader",
    image: "/images/manga-reader.jpg",
  },
  {
    name: "rmmv-animation-workspace",
    description: "Toolset for RPG Maker MV animations",
    longDescription: "A monorepo containing tools for RPG Maker MV animations — a standalone animation player and a web-based animation studio for creating and previewing battle animations.",
    language: "TypeScript",
    stars: 0,
    url: "https://github.com/deckyfx/rmmv-animation-workspace",
    image: "/images/rmmv.png",
  },
];

const repositories = [
  {
    name: "agenthub",
    description: "Command fleet of AI agents using a dashboard",
    language: "TypeScript",
    url: "https://github.com/deckyfx/agenthub"
  },
  {
    name: "anpan-os",
    description: "CasaOS Alternative powered by Bun",
    language: "TypeScript",
    url: "https://github.com/deckyfx/anpan-os"
  },
  {
    name: "dioxus-react-integration",
    description: "A rust lib to enable develop Dioxus app fully in react js side",
    language: "Rust",
    url: "https://github.com/deckyfx/dioxus-react-integration"
  },
  {
    name: "manga-reader",
    description: "Manga Reader + OCR + Translation",
    language: "TypeScript",
    url: "https://github.com/deckyfx/manga-reader"
  },
  {
    name: "emdash-blog",
    description: "Decky's blog run on Cloudflare Worker powered by EmDash",
    language: "Astro",
    url: "https://github.com/deckyfx/emdash-blog"
  },
  {
    name: "postgres-supercharged",
    description: "Someone said Postgres can replace your stacks, so i've tried it",
    language: "TypeScript",
    url: "https://github.com/deckyfx/postgres-supercharged"
  },
  {
    name: "rmmv-animation-workspace",
    description: "A monorepo containing tools for RPG Maker MV animations",
    language: "TypeScript",
    url: "https://github.com/deckyfx/rmmv-animation-workspace"
  },
  {
    name: "UsuiHon",
    description: "Doujin and Manga Aggregator",
    language: "TypeScript",
    url: "https://github.com/deckyfx/UsuiHon"
  },
  {
    name: "react-native-essentials",
    description: "Collection of Zero Dependencies useful react/react-native functions",
    language: "TypeScript",
    url: "https://github.com/deckyfx/react-native-essentials"
  },
  {
    name: "Kanriya",
    description: "All In One Business Management tools written in .NET 9",
    language: "C#",
    url: "https://github.com/deckyfx/Kanriya"
  }
];

const languageColors: Record<string, string> = {
  TypeScript: "#3178c6",
  Rust: "#ce422b",
  Java: "#b07219",
  "C#": "#239120",
  Astro: "#ff5a03",
  JavaScript: "#f1e05a",
  Kotlin: "#7f52ff",
  Shell: "#89e051",
  Groovy: "#4298b8"
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>deckyfx - Developer Portfolio</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
      color: #c9d1d9;
      line-height: 1.6;
      min-height: 100vh;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    header {
      text-align: center;
      margin-bottom: 60px;
      padding: 40px 0;
      border-bottom: 1px solid #30363d;
    }

    .header-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 4px solid #1f6feb;
      box-shadow: 0 0 20px rgba(31, 111, 235, 0.3);
      overflow: hidden;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    h1 {
      font-size: 2.5em;
      color: #f0f6fc;
      margin: 0;
    }

    .username {
      color: #1f6feb;
      font-size: 1.2em;
      font-weight: 600;
    }

    .bio {
      color: #8b949e;
      font-size: 1.1em;
      margin: 15px 0;
      max-width: 600px;
    }

    .social-links {
      display: flex;
      gap: 20px;
      margin-top: 20px;
      justify-content: center;
    }

    .social-links a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: rgba(31, 111, 235, 0.1);
      color: #1f6feb;
      text-decoration: none;
      border-radius: 6px;
      border: 1px solid #1f6feb;
      transition: all 0.3s ease;
      font-weight: 500;
    }

    .social-links a:hover {
      background: #1f6feb;
      color: #fff;
      transform: translateY(-2px);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 20px;
      margin-bottom: 60px;
    }

    .stat-card {
      background: #0d1117;
      border: 1px solid #30363d;
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      border-color: #1f6feb;
      background: rgba(31, 111, 235, 0.05);
    }

    .stat-value {
      font-size: 2em;
      color: #1f6feb;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .stat-label {
      color: #8b949e;
      font-size: 0.9em;
    }

    .repos-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 15px;
      border-bottom: 2px solid #30363d;
    }

    .repos-header h2 {
      font-size: 1.8em;
      color: #f0f6fc;
    }

    .repos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      margin-bottom: 60px;
    }

    .repo-card {
      background: #0d1117;
      border: 1px solid #30363d;
      border-radius: 8px;
      padding: 24px;
      transition: all 0.3s ease;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
      overflow: hidden;
    }

    .repo-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #1f6feb, #58a6ff);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .repo-card:hover {
      border-color: #1f6feb;
      background: rgba(31, 111, 235, 0.05);
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(31, 111, 235, 0.15);
    }

    .repo-card:hover::before {
      opacity: 1;
    }

    .repo-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }

    .repo-icon {
      width: 20px;
      height: 20px;
      color: #8b949e;
    }

    .repo-name {
      font-size: 1.1em;
      font-weight: 600;
      color: #1f6feb;
      text-decoration: none;
      transition: color 0.2s;
    }

    .repo-description {
      color: #8b949e;
      font-size: 0.95em;
      line-height: 1.5;
      flex-grow: 1;
    }

    .repo-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 12px;
      border-top: 1px solid #30363d;
    }

    .language-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 8px;
      background: rgba(31, 111, 235, 0.1);
      border-radius: 12px;
      font-size: 0.85em;
      font-weight: 500;
    }

    .language-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .repo-link {
      color: #1f6feb;
      text-decoration: none;
      font-size: 0.9em;
      transition: color 0.2s;
    }

    .repo-link:hover {
      color: #58a6ff;
    }

    /* Highlighted Repos */
    .highlighted-section {
      margin-bottom: 80px;
    }

    .highlight-item {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
      margin-bottom: 72px;
      padding-bottom: 72px;
      border-bottom: 1px solid #21262d;
    }

    .highlight-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .highlight-item.reverse {
      direction: rtl;
    }

    .highlight-item.reverse > * {
      direction: ltr;
    }

    .highlight-image {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #30363d;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .highlight-image:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 48px rgba(31, 111, 235, 0.15);
    }

    .highlight-image img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
    }

    .highlight-content {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .highlight-label {
      font-size: 0.75em;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #1f6feb;
    }

    .highlight-name {
      font-size: 1.6em;
      font-weight: 700;
      color: #f0f6fc;
      line-height: 1.2;
    }

    .highlight-desc {
      color: #8b949e;
      font-size: 0.95em;
      line-height: 1.7;
    }

    .highlight-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .highlight-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: #1f6feb;
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      font-size: 0.9em;
      font-weight: 500;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .highlight-link:hover {
      background: #388bfd;
      transform: translateY(-1px);
    }

    .highlight-stars {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #8b949e;
      font-size: 0.85em;
    }

    footer {
      text-align: center;
      padding: 40px 0;
      border-top: 1px solid #30363d;
      color: #8b949e;
      font-size: 0.9em;
    }

    @media (max-width: 768px) {
      h1 { font-size: 2em; }
      .repos-grid { grid-template-columns: 1fr; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .social-links { flex-wrap: wrap; }

      .highlight-item,
      .highlight-item.reverse {
        grid-template-columns: 1fr;
        direction: ltr;
        gap: 24px;
        margin-bottom: 48px;
        padding-bottom: 48px;
      }

      .highlight-image img { height: 200px; }
      .highlight-name { font-size: 1.3em; }
    }

    @media (max-width: 480px) {
      .container { padding: 20px 15px; }
      h1 { font-size: 1.5em; }
      .avatar { width: 80px; height: 80px; }
      .bio { font-size: 1em; }
      .repos-header h2 { font-size: 1.4em; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-content">
        <div class="avatar">
          <img
            src="https://avatars.githubusercontent.com/u/1076192?v=4"
            alt="deckyfx"
          />
        </div>
        <div>
          <h1>deckyfx</h1>
          <p class="username">@deckyfx</p>
          <p class="bio">Full-stack developer passionate about TypeScript, Rust, and building innovative tools. Interested in games, anime, and open-source projects.</p>
          <div class="social-links">
            <a href="https://github.com/deckyfx" target="_blank">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </svg>
              GitHub
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="stats">
      <div class="stat-card">
        <div class="stat-value">45+</div>
        <div class="stat-label">Public Repos</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">10+</div>
        <div class="stat-label">Languages</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">500+</div>
        <div class="stat-label">Contributions</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">Open</div>
        <div class="stat-label">For Collaboration</div>
      </div>
    </div>

    <!-- Highlighted Projects -->
    <section class="highlighted-section">
      <div class="repos-header">
        <h2>Highlighted Projects</h2>
      </div>

      {highlighted.map((repo, i) => (
        <div class={`highlight-item ${i % 2 === 1 ? 'reverse' : ''}`}>
          <a class="highlight-image" href={repo.url} target="_blank" rel="noopener noreferrer">
            <img src={repo.image} alt={repo.name} />
          </a>
          <div class="highlight-content">
            <span class="highlight-label">{repo.language}</span>
            <h3 class="highlight-name">{repo.name}</h3>
            <p class="highlight-desc">{repo.longDescription}</p>
            <div class="highlight-meta">
              <a class="highlight-link" href={repo.url} target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                View on GitHub
              </a>
              {repo.stars > 0 && (
                <span class="highlight-stars">
                  ★ {repo.stars}
                </span>
              )}
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- All Projects -->
    <section>
      <div class="repos-header">
        <h2>Featured Projects</h2>
      </div>
      <div class="repos-grid">
        {repositories.map((repo) => (
          <a href={repo.url} target="_blank" rel="noopener noreferrer" style={{ textDecoration: 'none' }}>
            <div class="repo-card">
              <div class="repo-header">
                <svg class="repo-icon" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 0 0 1.5h2.5A1.75 1.75 0 0 0 15 14.25V.75A1.75 1.75 0 0 0 13.25 0H4.5A2.5 2.5 0 0 0 2 2.5v11A1.5 1.5 0 0 0 3.5 15h7a.75.75 0 0 1 0 1.5h-7A2.5 2.5 0 0 1 2 13.5v-11Z"/>
                </svg>
                <span class="repo-name">{repo.name}</span>
              </div>
              <p class="repo-description">{repo.description}</p>
              <div class="repo-footer">
                <span class="language-badge">
                  <span
                    class="language-dot"
                    style={{ backgroundColor: languageColors[repo.language] || '#8b949e' }}
                  ></span>
                  {repo.language}
                </span>
                <span class="repo-link">View →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <footer>
      <p>© {new Date().getFullYear()} deckyfx. Built with Astro.</p>
    </footer>
  </div>
</body>
</html>
